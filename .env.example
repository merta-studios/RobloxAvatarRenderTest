DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional, aber für sofortige Command-Updates beim Testen empfohlen:
DISCORD_GUILD_ID=
# Render setzt PORT automatisch.
PORT=10000
CHROMIUM_PATH=/usr/bin/chromium
RENDER_TIMEOUT_SECONDS=420
MAX_ASSET_MB=30
# Zeitlimits für Discord-Verbindung und Command-Registrierung:
REST_TIMEOUT_SECONDS=20
LOGIN_TIMEOUT_SECONDS=90
# Gateway-Login: 0 = unbegrenzt weiterversuchen (empfohlen), sonst feste Anzahl.
LOGIN_ATTEMPTS=0
# Backoff zwischen den Versuchen (verdoppelt sich bis zum Maximum):
LOGIN_BACKOFF_SECONDS=5
LOGIN_BACKOFF_MAX_SECONDS=300
# DNS-Reihenfolge: 'ipv4first' (Standard) behebt bekannte Verbindungs-Hänger
# in Containern ohne IPv6-Route; 'verbatim' nutzt die System-Reihenfolge:
DNS_RESULT_ORDER=ipv4first
# Node "Happy Eyeballs" (paralleles IPv4/IPv6-Verbinden); Standard aus:
AUTO_SELECT_FAMILY=false
# /health liefert 503, solange der Bot nicht mit Discord verbunden ist.
# Auf Render besser 'false' lassen: sonst killt der Healthcheck den Container,
# während der Bot noch auf Discord wartet.
HEALTH_REQUIRE_DISCORD=false
# Ausführliche Debug-Logs von discord.js (REST/WebSocket):
DISCORD_DEBUG=false
# E2E ohne Discord-Gateway (Render-Pfad bleibt aktiv):
SKIP_DISCORD=false
# GET /render-debug?userId=1 – nur zum Diagnostizieren einschalten:
DEBUG_RENDER_ENDPOINT=false
# Optional: OpenCloud-API-Key (https://create.roblox.com/dashboard/credentials,
# "legacy-asset:manage" ist NICHT nötig – ein Key eines beliebigen Users reicht
# für öffentliche Assets). Seit April 2025 liefert Roblox UGC-Assets (Kleidung,
# Accessoires) ohne Authentifizierung nur noch mit HTTP 401; ohne Key werden
# solche Assets übersprungen (Avatar rendert trotzdem), mit Key lädt der Proxy
# sie über https://apis.roblox.com/asset-delivery-api nach:
# ROBLOX_OPENCLOUD_API_KEY=
# Optional: Discord-REST-Basis, Komma-getrennt, in dieser Reihenfolge.
# Standard: discord.com, canary.discord.com, ptb.discord.com, discordapp.com
# DISCORD_API_BASES=https://canary.discord.com/api,https://discord.com/api
