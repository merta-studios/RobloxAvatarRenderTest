DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional, aber für sofortige Command-Updates beim Testen empfohlen:
DISCORD_GUILD_ID=
# Render setzt PORT automatisch.
PORT=10000
CHROMIUM_PATH=/usr/bin/chromium
RENDER_TIMEOUT_SECONDS=420
MAX_ASSET_MB=30
# Zeitlimits für Discord-Verbindung und Command-Registrierung:
REST_TIMEOUT_SECONDS=30
LOGIN_TIMEOUT_SECONDS=60
# Gateway-Login: Anzahl Versuche und Abstand dazwischen:
LOGIN_ATTEMPTS=3
LOGIN_BACKOFF_SECONDS=5
# DNS-Reihenfolge: 'ipv4first' (Standard) behebt bekannte Verbindungs-Hänger
# in Containern ohne IPv6-Route; 'verbatim' nutzt die System-Reihenfolge:
DNS_RESULT_ORDER=ipv4first
# /health liefert 503, solange der Bot nicht mit Discord verbunden ist:
HEALTH_REQUIRE_DISCORD=true
# Ausführliche Debug-Logs von discord.js (REST/WebSocket):
DISCORD_DEBUG=false
